---
/* Silhouette — dragão ou espada em marca-d'água (parallax, baixa opacidade).
   Agora usa as fotos (recorte PNG com transparência) em src/assets, mantendo
   o mesmo papel decorativo de fundo das silhuetas anteriores. */
import { Picture } from 'astro:assets';
import dragao from '@/assets/dragao.png';
import espada from '@/assets/espada.png';

interface Props {
  variant: 'dragon' | 'sword';
}
const { variant } = Astro.props;
const src = variant === 'dragon' ? dragao : espada;
---

<Picture
  src={src}
  alt=""
  aria-hidden="true"
  draggable={false}
  class={`silh silh--${variant}`}
  widths={variant === 'dragon' ? [640, 1024] : [280, 480]}
  sizes={variant === 'dragon' ? '62vw' : '19vw'}
  formats={['avif', 'webp']}
  loading="lazy"
/>

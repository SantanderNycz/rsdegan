---
/* Nav — barra fixa, menu mobile e fio de progresso dourado.
   home=true: âncoras locais (#secção). home=false: liga a /#secção (volta à home).
   solid=true: nav já com fundo (páginas internas sem hero). */
import { nav, site } from '@/data/site';

interface Props {
  home?: boolean;
  solid?: boolean;
}
const { home = true, solid = false } = Astro.props;

// Em páginas internas, âncoras passam a apontar para a home.
const href = (h: string) => (home || !h.startsWith('#') ? h : `/${h}`);
const markHref = home ? '#topo' : '/';
---

<nav id="nav" class={solid ? 'stuck' : undefined}>
  <a href={markHref} class="mark">{site.name}</a>
  <button class="burger" id="burger" aria-label="Menu" aria-expanded="false" aria-controls="links">
    Menu
  </button>
  <div class="links" id="links">
    {nav.map((item) => <a href={href(item.href)}>{item.label}</a>)}
  </div>
</nav>
<div id="prog" aria-hidden="true"></div>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 26px 48px;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      padding 0.5s var(--ease),
      background 0.5s var(--ease),
      border-color 0.5s var(--ease),
      backdrop-filter 0.5s var(--ease);
  }
  nav.stuck {
    padding: 15px 48px;
    background: rgba(8, 10, 15, 0.72);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    border-bottom-color: rgba(159, 184, 212, 0.14);
  }
  .mark {
    font-family: var(--title);
    font-size: 19px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--bone);
    text-decoration: none;
    white-space: nowrap;
  }
  .links {
    display: flex;
    gap: 34px;
    align-items: center;
  }
  .links a {
    color: var(--bone);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.6;
    transition:
      opacity 0.4s,
      color 0.4s;
  }
  .links a:hover {
    opacity: 1;
    color: var(--gold);
  }

  /* fio de progresso */
  #prog {
    position: fixed;
    top: 0;
    left: 0;
    height: 1px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--gold);
    z-index: 81;
    opacity: 0;
    transition: opacity 0.5s;
    will-change: transform;
  }
  nav.stuck ~ #prog {
    opacity: 1;
  }

  .burger {
    display: none;
    background: none;
    border: 0;
    color: var(--bone);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    nav {
      padding: 18px 22px;
    }
    nav.stuck {
      padding: 12px 22px;
    }
    .links {
      position: fixed;
      inset: 0;
      background: rgba(8, 10, 15, 0.97);
      flex-direction: column;
      justify-content: center;
      gap: 34px;
      transform: translateY(-100%);
      transition: transform 0.6s var(--ease);
    }
    .links.open {
      transform: none;
    }
    .links a {
      font-size: 13px;
      letter-spacing: 0.3em;
      opacity: 1;
    }
    .burger {
      display: block;
      z-index: 85;
    }
  }
</style>
